# Copy to .env (never commit it) and change every value.
POSTGRES_PASSWORD=change-me-owner
VERITAS_APP_PASSWORD=change-me-app-role
SESSION_SECRET=change-me-long-random-string
VERITAS_DOMAIN=localhost
# 1 loads seed users and demo marks (password veritas2026): demos only, never production
VERITAS_DEMO=0
# The witness is only outside the DBA's reach if it is pushed somewhere they do not control:
WITNESS_GIT_REMOTE=
# Alerts when a verification fails (admins also get an in-app notification either way)
INTEGRITY_WEBHOOK=
SMTP_HOST=
ALERT_EMAIL_TO=
