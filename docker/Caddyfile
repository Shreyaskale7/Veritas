# VERITAS_DOMAIN=localhost gives a local self-signed certificate; a real domain gets a Let's Encrypt certificate automatically.
{$VERITAS_DOMAIN:localhost} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
